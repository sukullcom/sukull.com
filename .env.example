# Sukull — örnek ortam değişkenleri (gerçek değerleri buraya YAZMAYIN; Vercel/Railway kullanın)

NEXT_PUBLIC_APP_URL=https://sukull.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — runtime: pooler :6543; migration/script: DIRECT_URL :5432
DATABASE_URL=postgres://...@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgres://...@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Admin (virgülle ayrılmış; canlıda purge script bu listeyi korur)
ADMIN_EMAILS=you@example.com

# Canlı ödeme — sandbox DEĞİL
NEXT_PUBLIC_PAYMENT_SERVER_URL=https://your-project.up.railway.app
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# Cron & iç API
CRON_SECRET=
INTERNAL_API_KEY=

# E-posta (Resend)
RESEND_API_KEY=
RESEND_FROM=Sukull <noreply@sukull.com>

# İsteğe bağlı
# PURGE_KEEP_EMAILS=extra@example.com
# YOUTUBE_API_KEY=
